# Razorpay (Test Mode) - optional; MVP defaults to mock settlement
# RAZORPAY_KEY_ID=rzp_test_YOURKEYHERE
# RAZORPAY_KEY_SECRET=YOURSECRETHERE

# OpenAI - optional; only needed for the LLM catalog builder
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Application
APP_ENV=development
DATABASE_URL=sqlite:///./x402_in.db
MERCHANT_AGENT_PORT=8001
BUYER_AGENT_PORT=8000
MAX_NEGOTIATION_ROUNDS=2
OFFER_EXPIRY_MINUTES=10

# Frontend - only public safe values
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
